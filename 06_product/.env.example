BP_PROVIDER=auto
ANTHROPIC_API_KEY=
BP_MODEL=claude-opus-5-5
BP_EFFORT=high
# Passcode for the /admin metrics page; must be changed
BP_ADMIN_KEY=change-me
# Cost guardrails
BP_MAX_MEETINGS_PER_DAY=200
BP_MAX_LEDGER_MEETINGS_PER_DAY=10
